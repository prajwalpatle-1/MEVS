{
  "manifest_version": 3,
  "name": "MEVS Summarizer",
  "version": "0.1",
  "permissions": ["activeTab", "scripting","sidePanel"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "Summarize Video"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}